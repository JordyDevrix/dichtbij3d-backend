# ==============================================================================
# Dichtbij3D Backend Environment Variables
# Copy this file to .env and adjust the values for your environment.
# Note: In bash, load variables into your session with:
#   export $(grep -v '^#' .env | xargs) && mvn spring-boot:run
# ==============================================================================

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5433/dichtbij3d
DB_USER=dichtbij3d
DB_PASSWORD=dichtbij3d

# --- MinIO Object Storage (S3 compatible) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=dichtbij3d
MINIO_SECRET_KEY=dichtbij3d-secret
MINIO_BUCKET=dichtbij3d
STORAGE_FALLBACK_DIR=./.storage

# --- Security & JWT ---
# In production: provide a secure random secret of at least 64 characters
DICHTBIJ3D_JWT_SECRET=dev-only-insecure-secret-change-me-0123456789-abcdefghijklmnopqrstuvwxyz

# --- CORS & Origins ---
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://127.0.0.1:8081
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# --- Google OAuth / Sign In ---
# Web Client ID from Google Cloud Console (e.g. 123456789-xyz.apps.googleusercontent.com)
GOOGLE_OAUTH_CLIENT_ID=

# --- Bootstrap Admin & Demo Data ---
ADMIN_EMAIL=admin@dichtbij3d.nl
ADMIN_PASSWORD=Admin123!
DEMO_DATA=true

# --- Email / SMTP Settings (e.g. Google Workspace / Gmail) ---
# For Google Workspace: create a 16-character App Password via myaccount.google.com -> Security -> 2FA -> App Passwords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=jouw-account@jordydevrix.com
SPRING_MAIL_PASSWORD=jouw-16-letter-app-wachtwoord
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true

# --- Dichtbij3D Mail Sender Branding & Reset Tokens ---
MAIL_FROM=noreply@jordydevrix.com
MAIL_FROM_NAME=Dichtbij3D
FRONTEND_URL=http://localhost:8081
MAIL_RESET_TOKEN_TTL=PT30M
